   "kb": "in",
   "sfx": null,
   "i": 99,
   "start": 527.271,
   "end": 535.307,
   "voice_at": 527.351,
   "vd": 7.656
  },
  {
   "text": "He will keep playing for Al Nassr, where his contract runs until June 2027.",
