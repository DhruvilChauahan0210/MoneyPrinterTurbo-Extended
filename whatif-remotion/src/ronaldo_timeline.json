   "ov": [],
   "kb": "in",
   "sfx": null,
   "i": 95,
   "start": 504.871,
   "end": 510.507,
   "voice_at": 504.951,
   "vd": 5.256
  },
  {
   "text": "Look at what is left of his career. Five Ballon d'Or awards.",
