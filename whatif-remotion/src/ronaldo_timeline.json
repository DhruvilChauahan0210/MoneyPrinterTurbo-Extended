   "ov": [],
   "kb": "in",
   "sfx": null,
   "i": 107,
   "start": 565.975,
   "end": 573.051,
   "voice_at": 566.055,
   "vd": 6.696
  },
  {
   "text": "Two: it did not end with a farewell tour. It ended with a bench, a walkout and a suspension.",
